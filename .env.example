# Public API authentication
API_TOKEN=replace-with-at-least-32-random-characters

# Adapter
APP_NAME=hy-memory-aml
APP_VERSION=0.1.0
MAX_ADD_CONCURRENCY=16
MAX_SEARCH_CONCURRENCY=16
RAW_EVIDENCE_LIMIT=20
INCLUDE_OPTIONS_IN_QUERY=false
LOG_LEVEL=INFO

# Hy-Memory 2.0.3. AML Open-source Methods should use gpt-4o-mini during Add.
MEMORY_MODE=pro
MEMORY_LLM_PROVIDER=openai
MEMORY_LLM_MODEL=gpt-4o-mini
MEMORY_LLM_API_KEY=replace-with-your-key
MEMORY_LLM_BASE_URL=https://your-openai-compatible-provider.example/v1
MEMORY_LLM_TEMPERATURE=0
MEMORY_LLM_MAX_TOKENS=1024
MEMORY_AGENT_MAX_TOKENS=2000
MEMORY_LLM_TIMEOUT=180
MEMORY_LLM_MAX_RETRIES=5
MEMORY_LLM_GLOBAL_CONCURRENCY=16
MEMORY_LOG_LLM_CONTENT=false

# Any OpenAI-compatible embedding endpoint can be used. The dimensions must match.
MEMORY_EMBEDDER_PROVIDER=openai
MEMORY_EMBEDDER_MODEL=text-embedding-v4
MEMORY_EMBEDDER_API_KEY=replace-with-your-key
MEMORY_EMBEDDER_BASE_URL=https://your-embedding-provider.example/v1
MEMORY_EMBEDDING_DIMS=1024
MEMORY_EMBEDDER_TIMEOUT=30
MEMORY_EMBEDDER_MAX_RETRIES=3

# Persistent storage and retrieval used by the submitted instance.
MEMORY_VECTOR_STORE=chroma
MEMORY_COLLECTION_NAME=aml_memories_v1_1024
MEMORY_DATA_DIR=./data/hy-memory
MEMORY_PERSIST_DIR=./data/chroma
DATA_DIR=./data/adapter
HY_MEMORY_READER=hybrid
MEMORY_ENABLE_GRAPH=false
MEMORY_LOCAL_RERANK_ENABLED=false
MEMORY_ENABLE_INTENTION=true
MEMORY_EPISODE_SUMMARY_ENABLED=true
MEMORY_EPISODE_RECALL_ENABLED=true
MEMORY_HISTORY_RECORD_SEARCHES=false

# Transitional index retained only for reads of records written during an earlier
# deployment phase. New writes always use the synchronous Hy-Memory Pro pipeline.
FAST_MEMORY_ENABLED=false
FAST_MEMORY_READ_FALLBACK=true
FAST_MEMORY_COLLECTION_NAME=aml_fast_v1
FAST_MEMORY_PERSIST_DIR=./data/fast-chroma
FAST_MEMORY_BACKFILL_HOURS=0

