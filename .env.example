# Public deployment
DOMAIN=memory.example.com
ACME_EMAIL=ops@example.com
API_TOKEN=replace-with-at-least-32-random-characters
QDRANT_API_KEY=replace-with-a-different-random-secret

# Adapter
APP_NAME=hy-memory-aml
APP_VERSION=0.1.0
MAX_ADD_CONCURRENCY=4
MAX_SEARCH_CONCURRENCY=8
RAW_EVIDENCE_LIMIT=20
INCLUDE_OPTIONS_IN_QUERY=false
LOG_LEVEL=INFO

# Hy-Memory 2.0.3. AML Open-source Methods should use gpt-4o-mini during Add.
MEMORY_MODE=pro
MEMORY_LLM_PROVIDER=openai
MEMORY_LLM_MODEL=gpt-4o-mini
MEMORY_LLM_API_KEY=replace-with-your-key
MEMORY_LLM_BASE_URL=https://api.openai.com/v1
MEMORY_LLM_TEMPERATURE=0
MEMORY_LLM_MAX_TOKENS=1024
MEMORY_AGENT_MAX_TOKENS=2000
MEMORY_LLM_TIMEOUT=180
MEMORY_LLM_MAX_RETRIES=5
MEMORY_LOG_LLM_CONTENT=false

# Any OpenAI-compatible embedding endpoint can be used. The dimensions must match.
MEMORY_EMBEDDER_PROVIDER=openai
MEMORY_EMBEDDER_MODEL=text-embedding-3-small
MEMORY_EMBEDDER_API_KEY=replace-with-your-key
MEMORY_EMBEDDER_BASE_URL=https://api.openai.com/v1
MEMORY_EMBEDDING_DIMS=1536
MEMORY_EMBEDDER_TIMEOUT=30
MEMORY_EMBEDDER_MAX_RETRIES=3

# Retrieval. Qdrant is supplied by compose.yaml and is not exposed publicly.
MEMORY_COLLECTION_NAME=aml_memories_v1
HY_MEMORY_READER=hybrid
MEMORY_ENABLE_GRAPH=false
MEMORY_LOCAL_RERANK_ENABLED=false
MEMORY_ENABLE_INTENTION=true
MEMORY_EPISODE_SUMMARY_ENABLED=true
MEMORY_EPISODE_RECALL_ENABLED=true
MEMORY_HISTORY_RECORD_SEARCHES=false

